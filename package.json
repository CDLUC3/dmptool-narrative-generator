{
  "name": "dmptool-narrative-generator",
  "description": "Service that accepts a DMP as JSON and renders a narrative document",
  "author": "University of California Curation Center (UC3)<dmptool@ucop.edu>",
  "license": "MIT",
  "version": "1.0.0",
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/CDLUC3/dmptool-narrative-generator.git"
  },
  "type": "module",
  "scripts": {
    "build": "rm -rf ./dist && npm run compile",
    "compile": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "lint": "npx eslint . --ignore-pattern dist/",
    "prepare": "is-ci || npx husky install",
    "start": "node ./dist/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "trivy-high": "./src/scripts/trivy-high.sh",
    "trivy-med": "./src/scripts/trivy-med.sh"
  },
  "overrides": {
    "@humanfs/node": "0.17.0",
    "axios": "1.20.0",
    "brace-expansion": "5.0.12",
    "qs": "6.16.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.1"
    }
  },
  "dependencies": {
    "@dmptool/types": "^4.0.1",
    "@dmptool/utils": "^2.2.0",
    "@elastic/ecs-pino-format": "^1.5.0",
    "@turbodocx/html-to-docx": "^1.23.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-stringify": "^6.9.0",
    "domelementtype": "^3.0.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-jwt": "^8.5.1",
    "handlebars": "^4.7.9",
    "htmlparser2": "^12.0.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "mysql2": "^3.24.5",
    "pino": "^10.3.1",
    "pluralize": "^8.0.0",
    "pluralize-esm": "^9.0.5",
    "puppeteer": "^25.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expect-message": "^1.1.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
